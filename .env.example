# hrumbles-bulk-worker — example environment configuration.
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=

# Dedicated OpenAI key for the whole YOHR AI pipeline (yohr/ai_processor.py's
# normal path + yohr/ai_backfill.py), independent of OPENAI_API_KEY above, so
# YOHR's cost and rate limits are isolated from the rest of this backend
# (bulk_tasks.py's unrelated pipeline keeps using OPENAI_API_KEY unchanged).
# REQUIRED in production — config.py raises at startup if this is unset,
# unless YOHR_ALLOW_SHARED_KEY=true is also set (local dev only, see below).
YOHR_OPENAI_API_KEY=

# Local development only: set to true to let YOHR fall back to sharing
# OPENAI_API_KEY when YOHR_OPENAI_API_KEY is not set. Never set this in
# production — it defeats the cost/rate-limit isolation above.
YOHR_ALLOW_SHARED_KEY=

# Orgs this instance's YOHR pipeline (all 4 stages: csv_parser,
# resume_downloader, ai_processor, ingestor) should process, as a
# comma-separated list of org UUIDs. Leave unset for the default (both
# YO HR Consultancy and the demo org). Set to a single org id to temporarily
# exclude/include that org on this instance -- e.g. to hand exclusive
# processing of one org to a separate instance during a migration. Only
# affects the YOHR pipeline -- no effect on any other backend function/org.
YOHR_ACTIVE_ORG_IDS=

# YoHR CSV-intake worker trigger (shared secret with the Supabase edge
# function that calls POST /yohr/trigger to kick off processing immediately
# after an upload).
YOHR_TRIGGER_KEY=

# ── Optional (defaults shown match config.py) ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
STORAGE_BUCKET=talent-pool-resumes
STORAGE_BULK_PREFIX=bulk
RESUME_PARSER_URL=http://resume-parser-container:5005
PORT=5010
