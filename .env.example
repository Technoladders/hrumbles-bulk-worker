# hrumbles-bulk-worker — example environment configuration.
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── AI provider ───────────────────────────────────────────────────────────────
# "openai" (default, used in production) or "ollama" (local development
# against a locally-running Ollama server). Leave unset for today's
# production behavior — nothing below this section is required in that case.
AI_PROVIDER=openai

# Model name.
#   AI_PROVIDER=openai (default): e.g. gpt-4.1-nano
#   AI_PROVIDER=ollama:           e.g. qwen3:1.7b
AI_MODEL=gpt-4.1-nano

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Required only when AI_PROVIDER=ollama — Ollama's OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama-only, ignored by OpenAI. Context window size — see the comment above
# OLLAMA_NUM_CTX in yohr/constants.py for the sizing rationale. 16384 is a
# safe default for the existing 20,000-char input / 4,096-token output budget.
OLLAMA_NUM_CTX=16384

# Concurrent AI (stage 3) requests. Production default is 5. For local Ollama
# development, set this to 1 or 2 so a handful of simultaneous local model
# requests don't overwhelm your machine.
MAX_AI_WORKERS=5

# Orgs this instance's YOHR pipeline (all 4 stages) should process, as a
# comma-separated list of org UUIDs. Leave unset for today's default (both
# YO HR Consultancy and the demo org). Set to a single org id to temporarily
# isolate that org to one instance -- e.g. during a migration, so production
# and a local dev instance don't race to claim the same rows. Only affects
# the YOHR pipeline -- no effect on any other backend function/org.
#   Production (excludes YO HR Consultancy during migration):
#     YOHR_ACTIVE_ORG_IDS=53989f03-bdc9-439a-901c-45b274eff506
#   Local (only YO HR Consultancy):
#     YOHR_ACTIVE_ORG_IDS=2e569073-86de-4199-9d36-99dfe4d2e8f6
YOHR_ACTIVE_ORG_IDS=

# ── YoHR CSV-intake worker trigger (shared secret with the Supabase edge
# function that calls POST /yohr/trigger to kick off processing immediately
# after an upload) — optional for local testing; without it, the pipeline
# still runs on its normal 15-30s polling interval. ─────────────────────────
YOHR_TRIGGER_KEY=

# ── Redis / RQ ────────────────────────────────────────────────────────────────
# Only used by the separate bulk_tasks/RQ pipeline that shares this process —
# the YOHR pipeline (csv_parser/resume_downloader/ai_processor/ingestor) does
# not use Redis at all. The app will still start and YOHR jobs will still run
# without a reachable Redis; you'll just see periodic connection-error log
# lines from the unrelated bulk_tasks jobs, which are safe to ignore for YOHR
# development. Run a local Redis (e.g. `docker run -d -p 6379:6379 redis:7`)
# if you'd rather not see those.
REDIS_HOST=redis
REDIS_PORT=6379

# ── Storage / misc (defaults shown match config.py) ──────────────────────────
STORAGE_BUCKET=talent-pool-resumes
STORAGE_BULK_PREFIX=bulk
RESUME_PARSER_URL=http://resume-parser-container:5005
PORT=5010
